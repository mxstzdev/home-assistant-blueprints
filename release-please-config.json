      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Changed"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    }
  ],
  "packages": {
    "blueprints/automation/area-heating-control": {
      "component": "area-heating-control",
      "initial-version": "2.0.0",
      "extra-files": [
        {
          "type": "generic",
